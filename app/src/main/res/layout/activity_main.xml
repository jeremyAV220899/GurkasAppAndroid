<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F9"
    android:fillViewport="true"
    android:clipToPadding="false">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <!-- =============================== -->
        <!-- CABECERA / IMAGEN SUPERIOR -->
        <!-- =============================== -->

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="match_parent"
            android:layout_height="380dp"
            android:contentDescription="Gurkas Seguridad"
            android:scaleType="centerCrop"
            android:src="@drawable/gurkas_portada" />


        <!-- Oscurece ligeramente la portada -->
        <View
            android:layout_width="match_parent"
            android:layout_height="380dp"
            android:background="#22000000" />


        <!-- =============================== -->
        <!-- CONTENIDO DE LA PORTADA -->
        <!-- =============================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="105dp"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:paddingEnd="30dp">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-condensed"
                android:text="SEGURIDAD"
                android:textColor="#FFFFFF"
                android:textSize="39sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-7dp"
                android:fontFamily="sans-serif-condensed"
                android:text="DE OTRO NIVEL"
                android:textColor="#FF0808"
                android:textSize="38sp"
                android:textStyle="bold" />


            <TextView
                android:layout_width="245dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="3dp"
                android:text="Comprometidos con tu\nseguridad, siempre."
                android:textColor="#FFFFFF"
                android:textSize="18sp"

                android:shadowColor="#000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2.5" />


            <View
                android:layout_width="28dp"
                android:layout_height="3dp"
                android:layout_marginTop="18dp"
                android:background="#FF1111" />

        </LinearLayout>


        <!-- =============================== -->
        <!-- TARJETA LOGIN -->
        <!-- =============================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="23dp"
            android:layout_marginTop="350dp"
            android:layout_marginEnd="23dp"
            android:layout_marginBottom="40dp"
            android:background="@drawable/bg_login_card"
            android:elevation="10dp"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="28dp"
            android:paddingEnd="22dp"
            android:paddingBottom="28dp">


            <!-- =========================== -->
            <!-- TITULO -->
            <!-- =========================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <!-- CIRCULO ICONO -->
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/ic_security">

                </FrameLayout>


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="17dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Accede"
                        android:textColor="#303136"
                        android:textSize="27sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Ingresa tus datos de trabajador para continuar."
                        android:textColor="#65676C"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- =========================== -->
            <!-- USUARIO -->
            <!-- =========================== -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:text="Usuario: código de trabajador"
                android:textColor="#33353A"
                android:textSize="14sp"
                android:textStyle="bold" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_input_modern"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="10dp">


                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:contentDescription="Usuario"
                    android:src="@drawable/ic_person"
                    app:tint="#777B80" />


                <EditText
                    android:id="@+id/edtUsuario"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:hint="Ej: 1482720 o AVP71698935"
                    android:inputType="text"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:textColor="#333333"
                    android:textColorHint="#9A9DA1"
                    android:textSize="14sp" />

            </LinearLayout>


            <!-- EJEMPLO USUARIO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Información"
                    android:src="@drawable/ic_info"
                    app:tint="#666A70" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Ejemplo de usuario: AVP1533148"
                    android:textColor="#65676C"
                    android:textSize="12sp" />

            </LinearLayout>


            <!-- =========================== -->
            <!-- CONTRASEÑA -->
            <!-- =========================== -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="29dp"
                android:text="Contraseña"
                android:textColor="#33353A"
                android:textSize="14sp"
                android:textStyle="bold" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_input_modern"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp">


                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Contraseña"
                    android:src="@drawable/ic_lock"
                    app:tint="#777B80" />


                <EditText
                    android:id="@+id/edtPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:fontFamily="sans"
                    android:gravity="center_vertical"
                    android:hint="Ingresa tu contraseña"
                    android:inputType="textPassword"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:textColor="#333333"
                    android:textColorHint="#9A9DA1"
                    android:textSize="14sp" />


                <ImageButton
                    android:id="@+id/btnMostrarPassword"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:contentDescription="Mostrar contraseña"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/vista" />

            </LinearLayout>


            <!-- =========================== -->
            <!-- RECUPERAR CONTRASEÑA -->
            <!-- =========================== -->

            <TextView
                android:id="@+id/txtOlvide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:clickable="true"
                android:focusable="true"
                android:text="¿Olvidaste tu contraseña?"
                android:textColor="#260080"
                android:textSize="14sp" />


            <!-- =========================== -->
            <!-- BOTON INGRESAR -->
            <!-- =========================== -->

            <Button
                android:id="@+id/btnIngresar"
                android:layout_width="match_parent"
                android:layout_height="57dp"
                android:layout_marginTop="27dp"
                android:background="@drawable/bg_button_red"
                android:drawableStart="@drawable/ic_lock"
                android:drawablePadding="10dp"
                android:enabled="true"
                android:gravity="center"
                android:text="Ingresar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />


            <!-- =========================== -->
            <!-- PIE SEGURIDAD -->
            <!-- =========================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:orientation="horizontal">


                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E2E3E5" />


                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:alpha="0.45"
                    android:contentDescription="Seguridad"
                    android:src="@drawable/ic_security_logo" />


                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E2E3E5" />

            </LinearLayout>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:gravity="center"
                android:text="Tu seguridad es nuestra prioridad"
                android:textColor="#91949A"
                android:textSize="12sp" />


        </LinearLayout>

        <FrameLayout
            android:id="@+id/loadingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66000000"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:elevation="100dp">

            <androidx.cardview.widget.CardView
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:cardCornerRadius="18dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="28dp">

                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:indeterminate="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Iniciando sesión..."
                        android:textColor="#252525"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Validando tus datos"
                        android:textColor="#777777"
                        android:textSize="13sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </FrameLayout>

    </FrameLayout>

</ScrollView>