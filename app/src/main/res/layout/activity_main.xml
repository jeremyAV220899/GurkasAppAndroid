<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F8"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".MainActivity">


    <!-- ================================================= -->
    <!-- HEADER GENERAL -->
    <!-- ================================================= -->

    <FrameLayout
        android:id="@+id/headerPrincipal"
        android:layout_width="0dp"
        android:layout_height="225dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- FOTO DE FONDO -->

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/gurkas_portada_home"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />


        <!-- FILTRO ROJO -->

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent" />


        <!-- CONTENIDO DEL HEADER -->

        <LinearLayout
            android:id="@+id/headerContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="18dp"
            android:paddingEnd="22dp">


            <!-- USUARIO + ICONOS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <!-- USUARIO -->

                <ImageView
                    android:id="@+id/btnPerfil"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_usuario"
                    android:contentDescription="Usuario"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="#FFFFFF" />


                <!-- CÓDIGO -->

                <TextView
                    android:id="@+id/txtUsuario"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="71385575"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:ellipsize="end" />


                <!-- CARNET -->

                <ImageView
                    android:id="@+id/btnCarnet"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="18dp"
                    android:src="@drawable/ic_carnet"
                    android:contentDescription="Carnet"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="#FFFFFF" />


                <!-- NOTIFICACIÓN -->

                <ImageView
                    android:id="@+id/btnNotificacion"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_notificacion"
                    android:contentDescription="Notificaciones"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="#FFFFFF" />


            </LinearLayout>


            <!-- TÍTULO DINÁMICO -->

            <TextView
                android:id="@+id/txtTituloPantalla"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="¡Hola!"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:text="¡Hola!" />


        </LinearLayout>


        <!-- CURVA BLANCA -->

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_gravity="bottom"
            android:src="@drawable/bg_header_curve"
            android:scaleType="fitXY"
            android:contentDescription="@null" />


    </FrameLayout>



    <!-- ================================================= -->
    <!-- CONTENIDO DINÁMICO -->
    <!-- AQUÍ IRÁ HOME, CALENDARIO, NOTICIAS, ETC -->
    <!-- ================================================= -->

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/contenedorFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"


        android:layout_marginTop="-55dp"
        android:background="@android:color/transparent"

        app:layout_constraintTop_toBottomOf="@id/headerPrincipal"
        app:layout_constraintBottom_toTopOf="@id/menuInferior"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ================================================= -->
    <!-- MENÚ INFERIOR GENERAL -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/menuInferior"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:background="#FFFFFF"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="5dp"
        android:paddingBottom="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- ================================================= -->
        <!-- INICIO -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/btnInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">


            <View
                android:id="@+id/lineaInicio"
                android:layout_width="38dp"
                android:layout_height="3dp"
                android:layout_marginBottom="5dp"
                android:background="#D71920" />


            <ImageView
                android:id="@+id/iconInicio"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_home"
                android:contentDescription="Inicio"
                app:tint="#D71920" />


            <TextView
                android:id="@+id/textInicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Inicio"
                android:textColor="#D71920"
                android:textSize="11sp"
                android:textStyle="bold" />


        </LinearLayout>



        <!-- ================================================= -->
        <!-- ASISTENCIA -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/btnCalendario"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">


            <View
                android:id="@+id/lineaCalendario"
                android:layout_width="38dp"
                android:layout_height="3dp"
                android:layout_marginBottom="5dp"
                android:background="#FFFFFF" />


            <ImageView
                android:id="@+id/iconCalendario"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_calendario_2"
                android:contentDescription="Asistencia"
                app:tint="#3C414A" />


            <TextView
                android:id="@+id/textCalendario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Asistencia"
                android:textColor="#3C414A"
                android:textSize="10sp" />


        </LinearLayout>



        <!-- ================================================= -->
        <!-- NOTICIAS -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/btnNoticias"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">


            <View
                android:id="@+id/lineaNoticias"
                android:layout_width="38dp"
                android:layout_height="3dp"
                android:layout_marginBottom="5dp"
                android:background="#FFFFFF" />


            <ImageView
                android:id="@+id/iconNoticias"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_noticias"
                android:contentDescription="Noticias"
                app:tint="#3C414A" />


            <TextView
                android:id="@+id/textNoticias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Noticias"
                android:textColor="#3C414A"
                android:textSize="10sp" />


        </LinearLayout>



        <!-- ================================================= -->
        <!-- BOLETA -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/btnBoleta"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">


            <View
                android:id="@+id/lineaBoleta"
                android:layout_width="38dp"
                android:layout_height="3dp"
                android:layout_marginBottom="5dp"
                android:background="#FFFFFF" />


            <ImageView
                android:id="@+id/iconBoleta"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_boleta"
                android:contentDescription="Boleta"
                app:tint="#3C414A" />


            <TextView
                android:id="@+id/textBoleta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Boleta"
                android:textColor="#3C414A"
                android:textSize="10sp" />


        </LinearLayout>


    </LinearLayout>


    <!-- ================================================= -->
    <!-- STATUS BAR -->
    <!-- ================================================= -->

    <View
        android:id="@+id/statusBarOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:elevation="30dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>