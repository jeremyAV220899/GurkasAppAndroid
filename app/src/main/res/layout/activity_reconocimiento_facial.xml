<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"

    tools:context=".ReconocimientoFacialActivity">


    <!-- ====================================================== -->
    <!-- CÁMARA - NO MODIFICAR                                  -->
    <!-- ====================================================== -->

    <FrameLayout
        android:id="@+id/contenedorCamara"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewCamara"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scaleType="fillCenter" />


        <!-- FRAME CONGELADO -->
        <ImageView
            android:id="@+id/imgRostroConfirmado"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="Rostro confirmado" />


        <!-- ÓVALO - NO MODIFICAR DIMENSIONES -->
        <com.cloud.gurkasapp.FaceOvalOverlay
            android:id="@+id/faceOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false" />

    </FrameLayout>


    <!-- ====================================================== -->
    <!-- DEGRADADO SUPERIOR                                     -->
    <!-- ====================================================== -->

    <View
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_gradient_superior"
        android:clickable="false"
        android:focusable="false" />


    <!-- ====================================================== -->
    <!-- TÍTULO                                                 -->
    <!-- ====================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_gravity="top"

        android:gravity="center"
        android:orientation="vertical"

        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="26dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Verificación facial"

            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- ====================================================== -->
    <!-- PANEL INFERIOR                                         -->
    <!-- ====================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_gravity="bottom"

        android:orientation="vertical"

        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="18dp">


        <!-- ================================================== -->
        <!-- TARJETA                                           -->
        <!-- ================================================== -->

        <LinearLayout
            android:id="@+id/cardIdentidad"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:background="@drawable/bg_tarjeta_facial"

            android:orientation="vertical"

            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp">


            <!-- ================================================== -->
            <!-- ESTADO                                             -->
            <!-- ================================================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:gravity="center_vertical"
                android:orientation="horizontal">


                <View
                    android:id="@+id/indicadorEstado"

                    android:layout_width="10dp"
                    android:layout_height="10dp"

                    android:layout_marginEnd="10dp"

                    android:background="@drawable/bg_indicador_estado" />


                <TextView
                    android:id="@+id/txtEstado"

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:maxLines="2"

                    android:text="Coloque su rostro dentro del óvalo"

                    android:textColor="#90A4AE"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ================================================== -->
            <!-- SEPARADOR                                          -->
            <!-- ================================================== -->

            <View
                android:id="@+id/separadorEstado"

                android:layout_width="match_parent"
                android:layout_height="1dp"

                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"

                android:background="#25FFFFFF" />


            <!-- ================================================== -->
            <!-- TÍTULO DE TARJETA                                  -->
            <!-- ================================================== -->

            <TextView
                android:id="@+id/txtTituloIdentidad"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Verificación de identidad"

                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />


            <!-- ================================================== -->
            <!-- DESCRIPCIÓN                                        -->
            <!-- ================================================== -->

            <TextView
                android:id="@+id/txtDescripcion"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="5dp"

                android:maxLines="2"

                android:text="Mantén el rostro de frente y con buena iluminación."

                android:textColor="#AEB4BD"
                android:textSize="13sp" />


            <!-- ================================================== -->
            <!-- NOMBRE                                             -->
            <!-- ================================================== -->

            <TextView
                android:id="@+id/txtNombre"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="16dp"

                android:maxLines="2"

                android:text="Nombre: --"

                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />


            <!-- ================================================== -->
            <!-- DNI                                                -->
            <!-- ================================================== -->

            <TextView
                android:id="@+id/txtDni"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="6dp"

                android:text="DNI: --"

                android:textColor="#B7BDC6"
                android:textSize="14sp" />


            <!-- ================================================== -->
            <!-- BOTÓN                                              -->
            <!-- ================================================== -->

            <Button
                android:id="@+id/btnValidar"

                android:layout_width="match_parent"
                android:layout_height="52dp"

                android:layout_marginTop="18dp"

                android:backgroundTint="@color/color_boton_facial"

                android:enabled="false"

                android:stateListAnimator="@null"

                android:text="CONTINUAR"

                android:textColor="@color/color_boton_texto_facial"

                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>