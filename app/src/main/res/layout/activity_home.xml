<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F8"
    tools:context=".HomeActivity">

    <!-- CONTENIDO SCROLL -->
    <ScrollView
        android:id="@+id/scrollHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <!-- HEADER + TARJETA -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="320dp">

                <!-- HEADER -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="225dp">

                    <!-- FOTO -->
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/gurkas_portada_home"
                        android:scaleType="centerCrop"
                        android:contentDescription="@null" />

                    <!-- FILTRO ROJO -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                         />

                    <!-- CONTENIDO DEL HEADER -->
                    <LinearLayout
                        android:id="@+id/headerContent"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingStart="22dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="22dp">

                        <!-- USUARIO + ICONOS -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- USUARIO -->
                            <ImageView
                                android:id="@+id/btnPerfil"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:src="@drawable/ic_usuario"
                                android:contentDescription="Usuario"
                                android:clickable="true"
                                android:focusable="true"
                                app:tint="#FFFFFF" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="SCC47347496"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp" />

                            <!-- CARNET -->
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginEnd="18dp"
                                android:src="@drawable/ic_carnet"
                                android:contentDescription="Carnet"
                                app:tint="#FFFFFF" />

                            <!-- NOTIFICACIÓN -->
                            <ImageView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:src="@drawable/ic_notificacion"
                                android:contentDescription="Notificación"
                                app:tint="#FFFFFF" />

                        </LinearLayout>

                        <!-- HOLA -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="¡Hola!"
                            android:textColor="#FFFFFF"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- CURVA BLANCA INFERIOR -->
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_gravity="bottom"
                        android:src="@drawable/bg_header_curve"
                        android:scaleType="fitXY"
                        android:contentDescription="@null" />

                </FrameLayout>


                <!-- TARJETA MARCACIÓN -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="145dp"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="12dp">

                        <!-- MENSAJE -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="78dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp">

                            <!-- ICONO RELOJ -->
                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_reloj"
                                android:contentDescription="Reloj"
                                app:tint="#D71920" />

                            <!-- TEXTO -->
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:text="No hay más pendientes por hoy"
                                android:textColor="#181818"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- BOTÓN -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:background="@drawable/bg_btn_marcacion"
                            android:gravity="center"
                            android:text="Realizar marcación      ›"
                            android:textColor="#D71920"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </FrameLayout>


            <!-- ========================================= -->
            <!-- CONTENIDO GENERAL -->
            <!-- ========================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="115dp">


                <!-- RECORDATORIO MARCACIÓN -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="18dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="14dp">

                        <TextView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/ic_alfiler"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:text="¡No te olvides! Revisa y realiza tu marcación en el Sistema de Tareo de acuerdo con tu horario establecido."
                            android:textColor="#242424"
                            android:textSize="13sp"
                            android:lineSpacingExtra="2dp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>


                <!-- ========================================= -->
                <!-- TE PUEDE INTERESAR -->
                <!-- ========================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="Te puede interesar:"
                    android:textColor="#181818"
                    android:textSize="20sp"
                    android:textStyle="bold" />


                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="145dp"
                    android:layout_marginTop="14dp"
                    android:clipToPadding="false"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">


                        <!-- CONOCE TU SEDE -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="125dp"
                            android:layout_height="135dp"
                            android:layout_marginEnd="12dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="13dp"
                            app:cardElevation="4dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="8dp">

                                <TextView
                                    android:layout_width="82dp"
                                    android:layout_height="82dp"
                                    android:background="@drawable/ic_mapa"
                                    android:gravity="center" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:gravity="center"
                                    android:text="Conoce tu Sede"
                                    android:textColor="#181818"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="3dp"
                                    android:layout_marginTop="8dp"
                                    android:background="#D71920" />

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>


                        <!-- BOLSA DE TRABAJO -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="125dp"
                            android:layout_height="135dp"
                            android:layout_marginEnd="12dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="13dp"
                            app:cardElevation="4dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="8dp">

                                <TextView
                                    android:layout_width="82dp"
                                    android:layout_height="82dp"
                                    android:background="@drawable/ic_trabajo"
                                    android:gravity="center" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:gravity="center"
                                    android:text="Bolsa de trabajo"
                                    android:textColor="#181818"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="3dp"
                                    android:layout_marginTop="8dp"
                                    android:background="#D71920" />

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>


                        <!-- BENEFICIOS -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="125dp"
                            android:layout_height="135dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="13dp"
                            app:cardElevation="4dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="8dp">

                                <TextView
                                    android:layout_width="82dp"
                                    android:layout_height="82dp"
                                    android:background="@drawable/ic_beneficio"
                                    android:gravity="center" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:gravity="center"
                                    android:text="Beneficios"
                                    android:textColor="#181818"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="3dp"
                                    android:layout_marginTop="8dp"
                                    android:background="#D71920" />

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                </HorizontalScrollView>


                <!-- ========================================= -->
                <!-- GENERA UNA RESERVA -->
                <!-- ========================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:text="Genera una reserva de:"
                    android:textColor="#181818"
                    android:textSize="20sp"
                    android:textStyle="bold" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="105dp"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:weightSum="4">


                    <!-- RECURSOS HUMANOS -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="3dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="Recursos Humanos"
                            android:src="@drawable/ic_recursos_humanos"
                            app:tint="#D71920" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="Recursos&#10;Humanos"
                            android:textColor="#242424"
                            android:textSize="10sp" />

                    </LinearLayout>


                    <!-- DIVISOR -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="70dp"
                        android:layout_gravity="center_vertical"
                        android:background="#E4E4E4" />


                    <!-- SUCAMEC -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="3dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="Sucamec"
                            android:src="@drawable/ic_sucamec"
                            app:tint="#D71920" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="Sucamec"
                            android:textColor="#242424"
                            android:textSize="10sp" />

                    </LinearLayout>


                    <!-- DIVISOR -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="70dp"
                        android:layout_gravity="center_vertical"
                        android:background="#E4E4E4" />


                    <!-- PLANILLA -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="3dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="Planilla"
                            android:src="@drawable/ic_planilla"
                            app:tint="#D71920" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="Planilla"
                            android:textColor="#242424"
                            android:textSize="10sp" />

                    </LinearLayout>


                    <!-- DIVISOR -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="70dp"
                        android:layout_gravity="center_vertical"
                        android:background="#E4E4E4" />


                    <!-- LOGÍSTICA -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="3dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="Logística"
                            android:src="@drawable/ic_logistica"
                            app:tint="#D71920" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="Logística"
                            android:textColor="#242424"
                            android:textSize="10sp" />

                    </LinearLayout>

                </LinearLayout>


                <!-- ========================================= -->
                <!-- PLATAFORMAS DIGITALES -->
                <!-- ========================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:text="Tus plataformas digitales:"
                    android:textColor="#181818"
                    android:textSize="20sp"
                    android:textStyle="bold" />


                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginTop="14dp"
                    android:clipToPadding="false"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">


                        <!-- GURKAS WEB -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="310dp"
                            android:layout_height="140dp"
                            android:layout_marginEnd="14dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="4dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="horizontal">


                                <!-- IMAGEN -->
                                <LinearLayout
                                    android:layout_width="105dp"
                                    android:layout_height="match_parent"
                                    android:background="#FFF0F1"
                                    android:gravity="center">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="💻"
                                        android:textSize="42sp" />

                                </LinearLayout>


                                <!-- TEXTO -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:gravity="center_vertical"
                                    android:orientation="vertical"
                                    android:paddingStart="18dp"
                                    android:paddingTop="12dp"
                                    android:paddingBottom="12dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Gurkas WEB"
                                        android:textColor="#181818"
                                        android:textSize="20sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:text="Revisa el contenido de tus marcaciones"
                                        android:textColor="#55585F"
                                        android:textSize="12sp"
                                        android:lineSpacingExtra="2dp" />

                                </LinearLayout>


                                <!-- FLECHA -->
                                <TextView
                                    android:layout_width="35dp"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="›"
                                    android:textColor="#D71920"
                                    android:textSize="30sp" />

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>


                        <!-- CANAL DE DENUNCIA -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="310dp"
                            android:layout_height="140dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="4dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="horizontal">


                                <LinearLayout
                                    android:layout_width="105dp"
                                    android:layout_height="match_parent"
                                    android:background="#FFF0F1"
                                    android:gravity="center">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="📚"
                                        android:textSize="42sp" />

                                </LinearLayout>


                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:gravity="center_vertical"
                                    android:orientation="vertical"
                                    android:paddingStart="18dp"
                                    android:paddingTop="12dp"
                                    android:paddingBottom="12dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Canal de denuncia"
                                        android:textColor="#181818"
                                        android:textSize="18sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:text="Casos de corrupción y soborno"
                                        android:textColor="#55585F"
                                        android:textSize="12sp"
                                        android:lineSpacingExtra="2dp" />

                                </LinearLayout>


                                <TextView
                                    android:layout_width="35dp"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="›"
                                    android:textColor="#D71920"
                                    android:textSize="30sp" />

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                </HorizontalScrollView>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- ========================================= -->
    <!-- MENÚ INFERIOR -->
    <!-- ========================================= -->

    <LinearLayout
        android:id="@+id/menuInferior"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="bottom"
        android:background="#FFFFFF"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="5dp"
        android:paddingBottom="6dp">

        <!-- INICIO -->
        <LinearLayout
            android:id="@+id/btnInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:layout_width="38dp"
                android:layout_height="3dp"
                android:layout_marginBottom="5dp"
                android:background="#D71920" />

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:contentDescription="Inicio"
                android:src="@drawable/ic_home"
                app:tint="#D71920" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Inicio"
                android:textColor="#D71920"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ASISTENCIA -->
        <LinearLayout
            android:id="@+id/btnCalendario"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:layout_width="38dp"
                android:layout_height="3dp"
                android:layout_marginBottom="5dp"
                android:background="#FFFFFF" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Asistencia"
                android:src="@drawable/ic_calendario_2"
                app:tint="#3C414A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Asistencia"
                android:textColor="#3C414A"
                android:textSize="10sp" />

        </LinearLayout>


        <!-- NOTICIAS -->
        <LinearLayout
            android:id="@+id/btnCursos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:layout_width="38dp"
                android:layout_height="3dp"
                android:layout_marginBottom="5dp"
                android:background="#FFFFFF" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Noticias"
                android:src="@drawable/ic_noticias"
                app:tint="#3C414A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Noticias"
                android:textColor="#3C414A"
                android:textSize="10sp" />

        </LinearLayout>


        <!-- BOLETA -->
        <LinearLayout
            android:id="@+id/btnPagos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:layout_width="38dp"
                android:layout_height="3dp"
                android:layout_marginBottom="5dp"
                android:background="#FFFFFF" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Boleta"
                android:src="@drawable/ic_boleta"
                app:tint="#3C414A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Boleta"
                android:textColor="#3C414A"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- STATUS BAR OVERLAY -->
    <!-- IMPORTANTE: DEBE ESTAR AQUÍ AL FINAL -->
    <!-- ========================================= -->

    <View
        android:id="@+id/statusBarOverlay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:background="@android:color/transparent"
        android:elevation="30dp" />

</FrameLayout>