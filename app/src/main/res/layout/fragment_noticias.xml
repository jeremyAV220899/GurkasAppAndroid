<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/scrollNoticias"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".NoticiasFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- NOTICIA 1 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardNoticia1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <FrameLayout
                android:id="@+id/contenedorNoticia1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/imgNoticia1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:visibility="invisible"
                    android:contentDescription="Noticia 1" />

                <LinearLayout
                    android:id="@+id/loadingNoticia1"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="#FFFFFF">

                    <ProgressBar
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:indeterminateTint="#D71920" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Cargando noticia..."
                        android:textColor="#777777"
                        android:textSize="12sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/errorNoticia1"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="#FFFFFF"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No se pudo cargar la noticia"
                        android:textColor="#444444"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnReintentar1"
                        android:layout_width="130dp"
                        android:layout_height="42dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_borde_rojo"
                        android:gravity="center"
                        android:text="Reintentar"
                        android:textColor="#D71920"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </FrameLayout>

        </androidx.cardview.widget.CardView>

        <!-- NOTICIA 2 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardNoticia2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="22dp"

            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <FrameLayout
                android:id="@+id/contenedorNoticia2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">


                <!-- IMAGEN -->

                <ImageView
                    android:id="@+id/imgNoticia2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"

                    android:visibility="invisible"
                    android:contentDescription="Noticia 2" />


                <!-- CARGANDO -->

                <LinearLayout
                    android:id="@+id/loadingNoticia2"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"

                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ProgressBar
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:indeterminateTint="#D71920" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="10dp"

                        android:text="Cargando noticia..."
                        android:textColor="#777777"
                        android:textSize="12sp" />

                </LinearLayout>


                <!-- ERROR -->

                <LinearLayout
                    android:id="@+id/errorNoticia2"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"

                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp"

                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="No se pudo cargar la noticia"
                        android:textColor="#444444"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="4dp"

                        android:text="Comprueba tu conexión a Internet"
                        android:textColor="#888888"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btnReintentar2"
                        android:layout_width="130dp"
                        android:layout_height="42dp"

                        android:layout_marginTop="16dp"

                        android:background="@drawable/bg_borde_rojo"

                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"

                        android:text="Reintentar"
                        android:textColor="#D71920"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </FrameLayout>

        </androidx.cardview.widget.CardView>

        <!-- NOTICIA 3 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardNoticia3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="22dp"

            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <FrameLayout
                android:id="@+id/contenedorNoticia3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">


                <!-- IMAGEN -->

                <ImageView
                    android:id="@+id/imgNoticia3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"

                    android:visibility="invisible"
                    android:contentDescription="Noticia 3" />


                <!-- CARGANDO -->

                <LinearLayout
                    android:id="@+id/loadingNoticia3"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"

                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ProgressBar
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:indeterminateTint="#D71920" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="10dp"

                        android:text="Cargando noticia..."
                        android:textColor="#777777"
                        android:textSize="12sp" />

                </LinearLayout>


                <!-- ERROR -->

                <LinearLayout
                    android:id="@+id/errorNoticia3"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"

                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp"

                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="No se pudo cargar la noticia"
                        android:textColor="#444444"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="4dp"

                        android:text="Comprueba tu conexión a Internet"
                        android:textColor="#888888"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btnReintentar3"
                        android:layout_width="130dp"
                        android:layout_height="42dp"

                        android:layout_marginTop="16dp"

                        android:background="@drawable/bg_borde_rojo"

                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"

                        android:text="Reintentar"
                        android:textColor="#D71920"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </FrameLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>