<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F8"
    tools:context=".AsistenciaActivity">


    <!-- ================================================= -->
    <!-- HEADER -->
    <!-- ================================================= -->

    <FrameLayout
        android:id="@+id/headerAsistencia"
        android:layout_width="0dp"
        android:layout_height="180dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/gurkas_portada_home"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#82D00012" />

        <LinearLayout
            android:id="@+id/headerContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="18dp"
            android:paddingEnd="22dp">

            <!-- USUARIO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnPerfil"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_usuario"
                    android:contentDescription="Usuario"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="SCC47347496"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="18dp"
                    android:src="@drawable/ic_carnet"
                    android:contentDescription="Carnet"
                    app:tint="#FFFFFF" />

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/ic_notificacion"
                    android:contentDescription="Notificación"
                    app:tint="#FFFFFF" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Calendario"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

        </LinearLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_gravity="bottom"
            android:src="@drawable/bg_header_curve"
            android:scaleType="fitXY"
            android:contentDescription="@null" />

    </FrameLayout>


    <!-- ================================================= -->
    <!-- CONTENIDO -->
    <!-- ================================================= -->

    <androidx.cardview.widget.CardView
        android:id="@+id/cardCalendario"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="-30dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="6dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="18dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/headerAsistencia"
        app:layout_constraintBottom_toTopOf="@id/menuInferior"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">


            <!-- ================================================= -->
            <!-- ESTÁS VIENDO -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estás viendo:"
                    android:textColor="#333333"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtMesActual"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:textColor="#D71920"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Agosto 2026" />

                <TextView
                    android:id="@+id/btnHoy"
                    android:layout_width="82dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_borde_rojo"
                    android:gravity="center"
                    android:text="Ir a Hoy"
                    android:textColor="#D71920"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- SEMANA COMPACTA -->
            <!-- KOTLIN CREA LOS 7 DÍAS -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/calendarioSemana"
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:orientation="horizontal"
                android:paddingStart="5dp"
                android:paddingEnd="5dp" />


            <!-- ================================================= -->
            <!-- CALENDARIO EXPANDIDO -->
            <!-- ================================================= -->

            <ScrollView
                android:id="@+id/scrollCalendarioCompleto"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/calendarioCompleto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">


                    <!-- MES ACTUAL -->
                    <TextView
                        android:id="@+id/txtTituloMes"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:gravity="center"
                        android:textColor="#34495E"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Agosto 2026" />


                    <!-- CABECERA -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="35dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/DiaCabeceraCalendario"
                            android:text="L" />

                        <TextView
                            style="@style/DiaCabeceraCalendario"
                            android:text="M" />

                        <TextView
                            style="@style/DiaCabeceraCalendario"
                            android:text="M" />

                        <TextView
                            style="@style/DiaCabeceraCalendario"
                            android:text="J" />

                        <TextView
                            style="@style/DiaCabeceraCalendario"
                            android:text="V" />

                        <TextView
                            style="@style/DiaCabeceraCalendario"
                            android:text="S" />

                        <TextView
                            style="@style/DiaCabeceraCalendario"
                            android:text="D" />

                    </LinearLayout>


                    <GridLayout
                        android:id="@+id/gridMesActual"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="7" />


                    <!-- MES ANTERIOR -->
                    <TextView
                        android:id="@+id/txtMesSiguiente"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:textColor="#34495E"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Julio 2026" />


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="35dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/DiaCabeceraCalendario"
                            android:text="L" />

                        <TextView
                            style="@style/DiaCabeceraCalendario"
                            android:text="M" />

                        <TextView
                            style="@style/DiaCabeceraCalendario"
                            android:text="M" />

                        <TextView
                            style="@style/DiaCabeceraCalendario"
                            android:text="J" />

                        <TextView
                            style="@style/DiaCabeceraCalendario"
                            android:text="V" />

                        <TextView
                            style="@style/DiaCabeceraCalendario"
                            android:text="S" />

                        <TextView
                            style="@style/DiaCabeceraCalendario"
                            android:text="D" />

                    </LinearLayout>

                    <GridLayout
                        android:id="@+id/gridMesSiguiente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="7" />

                </LinearLayout>

            </ScrollView>


            <!-- ================================================= -->
            <!-- FLECHA -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/btnExpandirCalendario"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="⌄"
                android:textColor="#D71920"
                android:textSize="28sp"
                android:textStyle="bold" />


            <!-- ================================================= -->
            <!-- LISTA DE ASISTENCIA -->
            <!-- DESDE HOY HACIA ATRÁS -->
            <!-- ================================================= -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerDias"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#F4F5F7"
                android:clipToPadding="false"
                android:paddingStart="5dp"
                android:paddingTop="5dp"
                android:paddingEnd="5dp"
                android:paddingBottom="8dp"
                android:scrollbars="none" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>


    <!-- ================================================= -->
    <!-- MENÚ INFERIOR -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/menuInferior"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:background="#FFFFFF"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="5dp"
        android:paddingBottom="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- INICIO -->
        <LinearLayout
            android:id="@+id/btnInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:layout_width="38dp"
                android:layout_height="3dp"
                android:layout_marginBottom="5dp"
                android:background="#FFFFFF" />

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_home"
                android:contentDescription="Inicio"
                app:tint="#3C414A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Inicio"
                android:textColor="#3C414A"
                android:textSize="10sp" />

        </LinearLayout>


        <!-- ASISTENCIA -->
        <LinearLayout
            android:id="@+id/btnCalendario"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:layout_width="38dp"
                android:layout_height="3dp"
                android:layout_marginBottom="5dp"
                android:background="#D71920" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_calendario_2"
                android:contentDescription="Asistencia"
                app:tint="#D71920" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Asistencia"
                android:textColor="#D71920"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- NOTICIAS -->
        <LinearLayout
            android:id="@+id/btnCursos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:layout_width="38dp"
                android:layout_height="3dp"
                android:layout_marginBottom="5dp"
                android:background="#FFFFFF" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_noticias"
                android:contentDescription="Noticias"
                app:tint="#3C414A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Noticias"
                android:textColor="#3C414A"
                android:textSize="10sp" />

        </LinearLayout>


        <!-- BOLETA -->
        <LinearLayout
            android:id="@+id/btnPagos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:layout_width="38dp"
                android:layout_height="3dp"
                android:layout_marginBottom="5dp"
                android:background="#FFFFFF" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_boleta"
                android:contentDescription="Boleta"
                app:tint="#3C414A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Boleta"
                android:textColor="#3C414A"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>